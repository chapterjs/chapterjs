{
  "name": "chapterjs",
  "version": "0.2.2",
  "description": "The Discord framework",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chapterjs/chapterjs.git",
    "directory": "packages/chapterjs"
  },
  "homepage": "https://chapterjs.dev",
  "bugs": "https://github.com/chapterjs/chapterjs/issues",
  "types": "./dist/index.d.ts",
  "bin": {
    "chapterjs": "./dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:dave": "./scripts/build-dave.sh"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@chapterjs/test-utils": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
