{
  "name": "create-chapterjs",
  "version": "0.2.2",
  "description": "Alias of create-chapter: scaffolds a ChapterJS Discord bot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chapterjs/chapterjs.git",
    "directory": "packages/create-chapterjs"
  },
  "homepage": "https://chapterjs.dev",
  "bugs": "https://github.com/chapterjs/chapterjs/issues",
  "type": "module",
  "bin": {
    "create-chapterjs": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@chapterjs/test-utils": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "dependencies": {
    "create-chapter": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  }
}
