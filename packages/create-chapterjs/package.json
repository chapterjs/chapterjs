{
  "name": "create-chapterjs",
  "version": "0.2.3",
  "description": "Creates a ChapterJS Discord bot: pnpm create chapterjs",
  "keywords": [
    "discord",
    "discord-bot",
    "bot",
    "framework",
    "typescript",
    "slash-commands",
    "esm",
    "create",
    "scaffold",
    "template",
    "chapterjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chapterjs/chapterjs.git",
    "directory": "packages/create-chapterjs"
  },
  "homepage": "https://www.chapterjs.org",
  "bugs": "https://github.com/chapterjs/chapterjs/issues",
  "type": "module",
  "bin": {
    "create-chapterjs": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@chapterjs/test-utils": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "engines": {
    "node": ">=24"
  }
}
