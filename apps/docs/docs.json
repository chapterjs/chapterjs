{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "chapterjs",
  "colors": {
    "primary": "#5865F2",
    "light": "#949CF7",
    "dark": "#4752C4"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F5F6FC",
      "dark": "#0B0D1E"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Essentials",
        "pages": [
          "dev",
          "start",
          "commands",
          "events",
          "memory"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/overview",
          "reference/guild",
          "reference/member",
          "reference/user",
          "reference/role",
          "reference/channels",
          "reference/message",
          "reference/sending-messages",
          "reference/emojis-invites-webhooks",
          "reference/permissions",
          "reference/errors",
          "reference/helpers",
          "reference/values",
          "reference/options",
          "reference/data"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/chapterjs/chapterjs",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/chapterjs/chapterjs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/chapterjs/chapterjs"
    }
  }
}
