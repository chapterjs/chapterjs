{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ChapterJS",
  "description": "The Discord framework: a folder of files becomes a fast, type-safe Discord bot.",
  "colors": {
    "primary": "#5865F2",
    "light": "#949CF7",
    "dark": "#4752C4"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F5F6FC",
      "dark": "#0B0D1E"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "play",
            "pages": [
              "index",
              "quickstart",
              "setup/discord-application",
              "setup/project-structure"
            ]
          },
          {
            "group": "Commands",
            "icon": "terminal",
            "pages": [
              "commands/index",
              "commands/options",
              "commands/answering",
              "commands/translations"
            ]
          },
          {
            "group": "Events",
            "icon": "bolt",
            "pages": ["events/index", "events/messages"]
          },
          {
            "group": "Messages and memory",
            "icon": "message",
            "pages": ["messages", "memory"]
          },
          {
            "group": "Run your bot",
            "icon": "rocket",
            "pages": [
              "run/dev",
              "run/build",
              "run/start",
              "run/deploy",
              "run/troubleshooting"
            ]
          },
          {
            "group": "More",
            "icon": "compass",
            "pages": ["not-yet", "from-discord-js"]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Reference",
            "pages": ["reference/index"]
          },
          {
            "group": "Your files",
            "icon": "folder-tree",
            "pages": [
              "reference/command",
              "reference/event",
              "reference/events"
            ]
          },
          {
            "group": "Structures",
            "icon": "cubes",
            "pages": [
              "reference/guild",
              "reference/member",
              "reference/user",
              "reference/role",
              {
                "group": "Channels",
                "pages": [
                  "reference/channels/index",
                  "reference/channels/text",
                  "reference/channels/voice",
                  "reference/channels/category",
                  "reference/channels/forum",
                  "reference/channels/thread",
                  "reference/channels/dm"
                ]
              },
              "reference/message",
              "reference/interaction",
              "reference/emoji",
              "reference/invite",
              "reference/webhook"
            ]
          },
          {
            "group": "Types",
            "icon": "brackets-curly",
            "pages": [
              "reference/message-options",
              "reference/options",
              "reference/data",
              "reference/permissions",
              "reference/enums",
              "reference/helpers",
              "reference/errors"
            ]
          },
          {
            "group": "CLI",
            "icon": "square-terminal",
            "pages": ["reference/cli"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/chapterjs/chapterjs",
          "icon": "github"
        },
        {
          "anchor": "Discord developer docs",
          "href": "https://docs.discord.com/developers",
          "icon": "discord"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/chapterjs/chapterjs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "redirects": [
    { "source": "/dev", "destination": "/run/dev" },
    { "source": "/build", "destination": "/run/build" },
    { "source": "/start", "destination": "/run/start" },
    { "source": "/reference/overview", "destination": "/reference" },
    { "source": "/reference/values", "destination": "/reference/enums" },
    { "source": "/reference/sending-messages", "destination": "/messages" },
    { "source": "/reference/emojis-invites-webhooks", "destination": "/reference/emoji" }
  ],
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "ChapterJS"
    }
  },
  "search": {
    "prompt": "Search the docs, or ask how to do something..."
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/chapterjs/chapterjs"
    }
  }
}
